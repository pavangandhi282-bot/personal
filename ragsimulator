  <script>
    const defaultDocument = `Retrieval augmented generation, usually called RAG, combines information retrieval with text generation. It helps a language model answer questions using information from an external knowledge source.

The ingestion process begins by loading documents. Large documents are divided into smaller chunks because embedding and language models have context limits. Smaller chunks also make it easier to retrieve a focused passage.

Chunk overlap repeats a small amount of text between neighboring chunks. This reduces the chance that an important idea is split across a chunk boundary. Too much overlap, however, creates duplicate information and increases storage and retrieval costs.

Each chunk is converted into an embedding. An embedding is a numerical representation of meaning. Similar pieces of text should produce vectors that are close together in the embedding space.

When a user asks a question, the question is embedded using the same embedding model. A vector database compares the question vector with stored chunk vectors and returns the most similar chunks.

Some systems rerank the retrieved chunks with a more accurate model. The selected chunks are then placed inside a prompt as context. The language model uses that context to create a grounded answer.

RAG can reduce hallucinations, but it does not guarantee correctness. Poor source documents, bad chunking, weak retrieval, or unclear prompts can still produce an incorrect answer.`;

    const stages = [
      {
        name: "Documents",
        description: "Raw information enters the RAG system."
      },
      {
        name: "Chunking",
        description: "The document is split into smaller passages."
      },
      {
        name: "Embeddings",
        description: "Text is represented as numerical vectors."
      },
      {
        name: "Retrieval",
        description: "The question is compared with every chunk."
      },
      {
        name: "Prompt",
        description: "Retrieved evidence is added to the model prompt."
      },
      {
        name: "Generation",
        description: "A grounded answer is produced from the evidence."
      }
    ];

    const stopWords = new Set([
      "a", "an", "and", "are", "as", "at", "be", "because", "by", "for",
      "from", "has", "in", "is", "it", "of", "on", "or", "that", "the",
      "this", "to", "was", "were", "will", "with", "what", "when", "why",
      "how", "does", "do", "into", "using", "user"
    ]);

    const state = {
      activeStage: 0,
      chunks: [],
      rankedChunks: []
    };

    const pipeline = document.getElementById("pipeline");
    const documentInput = document.getElementById("documentInput");
    const chunkSizeInput = document.getElementById("chunkSize");
    const topKInput = document.getElementById("topK");
    const questionInput = document.getElementById("questionInput");
    const stageHeading = document.getElementById("stageHeading");
    const stageDescription = document.getElementById("stageDescription");
    const stageContent = document.getElementById("stageContent");

    documentInput.value = defaultDocument;

    function escapeHtml(value) {
      return value.replace(/[&<>"']/g, character => {
        const characters = {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;"
        };

        return characters[character];
      });
    }

    function tokenize(text) {
      return text
        .toLowerCase()
        .replace(/[^a-z0-9\s]/g, " ")
        .split(/\s+/)
        .filter(word => word.length > 1 && !stopWords.has(word));
    }

    function createChunks(text, chunkSize) {
      const words = text.trim().split(/\s+/).filter(Boolean);
      const overlap = Math.max(3, Math.floor(chunkSize * 0.2));
      const chunks = [];

      for (
        let start = 0;
        start < words.length;
        start += Math.max(1, chunkSize - overlap)
      ) {
        const content = words.slice(start, start + chunkSize).join(" ");

        if (content) {
          chunks.push({
            id: chunks.length + 1,
            content,
            start,
            end: Math.min(start + chunkSize, words.length)
          });
        }

        if (start + chunkSize >= words.length) {
          break;
        }
      }

      return chunks;
    }

    function termFrequency(tokens) {
      const frequency = {};

      tokens.forEach(token => {
        frequency[token] = (frequency[token] || 0) + 1;
      });

      const total = tokens.length || 1;

      Object.keys(frequency).forEach(token => {
        frequency[token] /= total;
      });

      return frequency;
    }

    function cosineSimilarity(vectorA, vectorB) {
      const terms = new Set([
        ...Object.keys(vectorA),
        ...Object.keys(vectorB)
      ]);

      let dotProduct = 0;
      let magnitudeA = 0;
      let magnitudeB = 0;

      terms.forEach(term => {
        const valueA = vectorA[term] || 0;
        const valueB = vectorB[term] || 0;

        dotProduct += valueA * valueB;
        magnitudeA += valueA * valueA;
        magnitudeB += valueB * valueB;
      });

      if (!magnitudeA || !magnitudeB) {
        return 0;
      }

      return dotProduct / (Math.sqrt(magnitudeA) * Math.sqrt(magnitudeB));
    }

    function rankChunks(chunks, question) {
      const questionVector = termFrequency(tokenize(question));

      return chunks
        .map(chunk => {
          const chunkVector = termFrequency(tokenize(chunk.content));

          return {
            ...chunk,
            vector: chunkVector,
            score: cosineSimilarity(questionVector, chunkVector)
          };
        })
        .sort((first, second) => second.score - first.score);
    }

    function createMiniVector(text) {
      const tokens = tokenize(text);
      const bars = Array.from({ length: 22 }, (_, index) => {
        let value = 12;

        tokens.forEach(token => {
          const character = token.charCodeAt(index % token.length);
          value += (character * (index + 3)) % 32;
        });

        return Math.min(44, value);
      });

      return `
        <div class="vector" title="A simplified visual representation">
          ${bars.map(height => `<span style="height:${height}px"></span>`).join("")}
        </div>
      `;
    }

    function generateAnswer(selectedChunks, question) {
      if (!selectedChunks.length || selectedChunks[0].score === 0) {
        return "The retrieved context does not contain enough relevant information to answer this question confidently.";
      }

      const keywords = tokenize(question);
      const sentences = selectedChunks
        .flatMap(chunk => chunk.content.split(/(?<=[.!?])\s+/))
        .map(sentence => ({
          sentence: sentence.trim(),
          relevance: keywords.reduce((score, keyword) => {
            return score + (
              sentence.toLowerCase().includes(keyword) ? 1 : 0
            );
          }, 0)
        }))
        .filter(item => item.sentence)
        .sort((first, second) => second.relevance - first.relevance)
        .slice(0, 3)
        .map(item => item.sentence);

      return sentences.join(" ");
    }

    function updateData() {
      const chunkSize = Number(chunkSizeInput.value) || 35;
      const documentText = documentInput.value.trim();
      const question = questionInput.value.trim();

      state.chunks = createChunks(documentText, chunkSize);
      state.rankedChunks = rankChunks(state.chunks, question);
    }

    function renderPipeline() {
      pipeline.innerHTML = stages.map((stage, index) => `
        <button
          class="step-button ${index === state.activeStage ? "active" : ""}"
          data-stage="${index}"
        >
          <span class="step-number">STEP ${index + 1}</span>
          <span class="step-name">${stage.name}</span>
        </button>
      `).join("");

      pipeline.querySelectorAll(".step-button").forEach(button => {
        button.addEventListener("click", () => {
          state.activeStage = Number(button.dataset.stage);
          render();
        });
      });
    }

    function renderDocuments() {
      const text = documentInput.value.trim();
      const wordCount = text ? text.split(/\s+/).length : 0;

      return `
        <div class="data-card">
          <div class="card-meta">
            <span>Knowledge source 01</span>
            <span>${wordCount} words</span>
          </div>
          <p>${escapeHtml(text || "No document supplied.")}</p>
        </div>

        <div class="callout">
          In a real system, this information could come from PDFs, web pages,
          databases, product documentation, or private company files.
        </div>
      `;
    }

    function renderChunks() {
      return `
        <div class="cards">
          ${state.chunks.map(chunk => `
            <article class="data-card">
              <div class="card-meta">
                <span>Chunk ${chunk.id}</span>
                <span>Words ${chunk.start + 1} to ${chunk.end}</span>
              </div>
              <p>${escapeHtml(chunk.content)}</p>
            </article>
          `).join("")}
        </div>

        <div class="callout">
          This demo uses 20 percent overlap. Overlap preserves ideas that cross
          a chunk boundary, but excessive overlap creates duplicated results.
        </div>
      `;
    }

    function renderEmbeddings() {
      return `
        <div class="cards">
          ${state.chunks.map(chunk => {
            const importantTokens = [...new Set(tokenize(chunk.content))]
              .slice(0, 8);

            return `
              <article class="data-card">
                <div class="card-meta">
                  <span>Chunk ${chunk.id} embedding</span>
                  <span>${importantTokens.length} visible features</span>
                </div>
                <div>
                  ${importantTokens.map(token => `
                    <span class="token">${escapeHtml(token)}</span>
                  `).join("")}
                </div>
                ${createMiniVector(chunk.content)}
              </article>
            `;
          }).join("")}
        </div>

        <div class="callout">
          Real embeddings can contain hundreds or thousands of numbers.
          The bars shown here are a teaching visualization, not a real model.
        </div>
      `;
    }

    function renderRetrieval() {
      const topK = Number(topKInput.value);

      return `
        <div class="cards">
          ${state.rankedChunks.map((chunk, index) => `
            <article class="data-card ${index < topK ? "selected" : ""}">
              <div class="card-meta">
                <span>
                  Rank ${index + 1} · Chunk ${chunk.id}
                  ${index < topK ? " · Retrieved" : ""}
                </span>
                <span class="score">
                  ${(chunk.score * 100).toFixed(1)}% similarity
                </span>
              </div>
              <p>${escapeHtml(chunk.content)}</p>
            </article>
          `).join("")}
        </div>

        <div class="callout">
          This browser demo uses word similarity. Production systems normally
          use embedding models, vector databases, metadata filters, and
          sometimes a reranker.
        </div>
      `;
    }

    function renderPrompt() {
      const topK = Number(topKInput.value);
      const selectedChunks = state.rankedChunks.slice(0, topK);
      const context = selectedChunks
        .map(chunk => `[Source ${chunk.id}]\n${chunk.content}`)
        .join("\n\n");

      const prompt = `SYSTEM
Answer only from the supplied context.
If the context is insufficient, say that you do not know.
Include source references.

CONTEXT
${context || "No context retrieved."}

QUESTION
${questionInput.value.trim() || "No question supplied."}

ANSWER`;

      return `
        <div class="prompt-box">${escapeHtml(prompt)}</div>

        <div class="callout">
          Prompt construction connects retrieval to generation. Strong
          instructions help the model use evidence and admit uncertainty.
        </div>
      `;
    }

    function renderGeneration() {
      const topK = Number(topKInput.value);
      const selectedChunks = state.rankedChunks.slice(0, topK);
      const answer = generateAnswer(
        selectedChunks,
        questionInput.value.trim()
      );

      const citations = selectedChunks
        .filter(chunk => chunk.score > 0)
        .map(chunk => `Source ${chunk.id}`)
        .join(", ");

      return `
        <div class="answer">
          ${escapeHtml(answer)}
          ${citations ? `<br><br><strong>Evidence</strong> · ${citations}` : ""}
        </div>

        <div class="cards" style="margin-top:16px">
          ${selectedChunks.map(chunk => `
            <article class="data-card selected">
              <div class="card-meta">
                <span>Source ${chunk.id}</span>
                <span class="score">
                  ${(chunk.score * 100).toFixed(1)}%
                </span>
              </div>
              <p>${escapeHtml(chunk.content)}</p>
            </article>
          `).join("")}
        </div>

        <div class="callout">
          This answer is assembled extractively for demonstration. A real RAG
          application sends the prompt to a language model, which writes a new
          response using the retrieved evidence.
        </div>
      `;
    }

    function renderStageContent() {
      const renderers = [
        renderDocuments,
        renderChunks,
        renderEmbeddings,
        renderRetrieval,
        renderPrompt,
        renderGeneration
      ];

      if (!documentInput.value.trim()) {
        return `
          <div class="empty-state">
            <div>
              <div class="empty-icon">?</div>
              <strong>Add a knowledge document</strong>
              <p>The pipeline needs source information before it can run.</p>
            </div>
          </div>
        `;
      }

      return renderers[state.activeStage]();
    }

    function render() {
      updateData();
      renderPipeline();

      const stage = stages[state.activeStage];
      stageHeading.textContent = `${state.activeStage + 1}. ${stage.name}`;
      stageDescription.textContent = stage.description;
      stageContent.innerHTML = renderStageContent();
    }

    document.getElementById("runButton").addEventListener("click", () => {
      state.activeStage = 0;
      render();

      let nextStage = 1;

      const animation = setInterval(() => {
        state.activeStage = nextStage;
        render();
        nextStage += 1;

        if (nextStage >= stages.length) {
          clearInterval(animation);
        }
      }, 420);
    });

    document.getElementById("resetButton").addEventListener("click", () => {
      documentInput.value = defaultDocument;
      chunkSizeInput.value = 35;
      topKInput.value = 2;
      questionInput.value = "Why does chunk overlap help retrieval?";
      state.activeStage = 0;
      render();
    });

    [
      documentInput,
      chunkSizeInput,
      topKInput,
      questionInput
    ].forEach(control => {
      control.addEventListener("input", render);
      control.addEventListener("change", render);
    });

    render();
  </script>
</body>
</html>
